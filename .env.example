# Application
RULEREADER_APP_NAME=RuleReader
RULEREADER_ENVIRONMENT=development
RULEREADER_HOST=127.0.0.1
RULEREADER_PORT=8000
RULEREADER_LOG_LEVEL=INFO
RULEREADER_RELOAD=false

# MongoDB
# MongoDB uses its own URI scheme. Do not use http://localhost:27017/.
# If authentication is enabled, use for example:
# mongodb://<username>:<url-encoded-password>@localhost:27017/?authSource=admin
RULEREADER_MONGODB_URI=mongodb://localhost:27017/
RULEREADER_MONGODB_DATABASE=rule_reader
RULEREADER_MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
RULEREADER_MONGODB_CONNECT_TIMEOUT_MS=5000

# Rule parser
RULEREADER_DOCUMENT_ROOT=documents
RULEREADER_RULE_MAX_CHARACTERS=100000

# DeepSeek
RULEREADER_DEEPSEEK_API_KEY=
RULEREADER_DEEPSEEK_BASE_URL=https://api.deepseek.com
RULEREADER_DEEPSEEK_MODEL=deepseek-v4-flash
RULEREADER_DEEPSEEK_TIMEOUT_SECONDS=90
RULEREADER_DEEPSEEK_MAX_RETRIES=2
RULEREADER_DEEPSEEK_MAX_OUTPUT_TOKENS=16384
RULEREADER_DEEPSEEK_RETRY_BASE_DELAY_SECONDS=1
RULEREADER_DEEPSEEK_RETRY_MAX_DELAY_SECONDS=8
RULEREADER_DEEPSEEK_IDEMPOTENCY_CACHE_MAX_ENTRIES=64
